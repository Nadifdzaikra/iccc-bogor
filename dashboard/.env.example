# Salin ke .env lalu isi. File .env TIDAK ikut ke image Docker.

# ── Aplikasi (dibaca saat BUILD, bukan saat container jalan) ────
# Template URL HLS kamera CCTV halaman Surveillance.
# {id} diganti ID kamera (mis. CAM-001). Kosongkan untuk mode demo.
NEXT_PUBLIC_CCTV_HLS_TEMPLATE=

# Style peta MapLibre (opsional). Kosong = default OpenFreeMap.
NEXT_PUBLIC_MAP_STYLE_LIGHT=
NEXT_PUBLIC_MAP_STYLE_3D=
NEXT_PUBLIC_MAP_STYLE_DARK=
NEXT_PUBLIC_MAP_STYLE_POSITRON=

# ── Docker (dibaca docker compose) ─────────────────────────────
# Nama & tag image. Pakai nomor versi (mis. 1.0.0) agar bisa rollback.
IMAGE_NAME=nadifhartaman/iccc-bogor-dashboard
IMAGE_TAG=latest
# Port di host → container 3000
HOST_PORT=3055
